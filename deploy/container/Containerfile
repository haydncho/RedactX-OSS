# 锐消 RedactX 服务镜像（Apple container / OCI 通用）
# 构建前先导出正文人名识别模型：.venv/bin/python deploy/ner_export.py（写入 models/ner/）
# 构建：container build -t redactx:<版本> -f deploy/container/Containerfile .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    REDACTX_DATA=/data \
    REDACTX_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc \
    REDACTX_SOFFICE=/usr/bin/soffice \
    REDACTX_NER_DIR=/app/models/ner

# 中文字体（打码标签用）、ONNX Runtime 依赖、LibreOffice（Word/WPS 等文档转 PDF）
RUN apt-get update \
 && apt-get install -y --no-install-recommends fonts-noto-cjk libgomp1 \
      libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml deploy/container/requirements.lock ./
# 依赖按锁文件安装：版本固定，每个包核对 SHA-256，任何一个被替换都会构建失败。
# 锁文件由 uv pip compile --generate-hashes 生成（Linux arm64、Python 3.12），不含完整版 opencv-python
# （rapidocr 声明依赖它，但它要 libGL；cv2 由 opencv-python-headless 提供），所以用 --no-deps 安装
RUN pip install --require-hashes --no-deps -r requirements.lock \
 && python -c "import cv2; print(cv2.__version__)" \
 # 构建时校验 OCR 模型已随包安装，运行时不再联网下载
 && python -c "import rapidocr, pathlib; m = pathlib.Path(rapidocr.__file__).parent / 'models'; fs = sorted(p.name for p in m.glob('*.onnx')); print(fs); assert fs"

COPY redactx ./redactx
COPY service ./service
COPY web ./web
# 正文人名识别模型：先在本机运行 deploy/ner_export.py 导出到 models/ner/
COPY models/ner ./models/ner
RUN python -c "from redactx.detect import ner; assert ner.available(); print(ner.find_names('今日李建国主任医师查房。'))"

RUN useradd --create-home --uid 10001 redactx && mkdir -p /data && chown redactx /data
USER redactx
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/v1/health')" || exit 1
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8000"]
