# 复制为 deploy/docker/.env 后填写（.env 已加入 .gitignore，不要提交）
# 管理员 Key：设置后所有接口都要带 X-API-Key。对外提供服务时必须设置；用户 Key 用 deploy/keys.sh 生成
REDACTX_API_KEY=
# 端口（只绑定 127.0.0.1）与容器名
REDACTX_PORT=8090
REDACTX_CONTAINER=redactx-oss
# 单个任务同时处理的页数：2 较快，1 最省内存
REDACTX_PAGE_WORKERS=2
# 结果保留时长（小时）
REDACTX_RETENTION_HOURS=24
# 设为 1：无法为 Word 等文档转换创建沙箱时拒绝转换（Docker 默认安全配置下通常无法创建，见 README）
REDACTX_REQUIRE_SANDBOX=
# 标注导出（含真实病案内容），只在授权的标注环境里打开
REDACTX_ALLOW_EXPORT=
